{
  "manifest_version": 2,
  "name": "Image Overlay",
  "version": "1.0",
  "description": "Overlay an image on any webpage — drag, resize, adjust opacity, and remove via context menu.",
  "icons": {
    "48": "icons/icon-48.svg"
  },
  "permissions": [
    "activeTab",
    "contextMenus"
  ],
  "browser_action": {
    "default_icon": "icons/icon-48.svg",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
